# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://depthub:depthub@localhost:5433/depthub
REDIS_URL=redis://localhost:6379/0

# Email: console backend prints messages in the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DeptHub <no-reply@depthub.local>

# Paystack test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# disabled | console. Keep disabled when the seed data is loaded.
SMS_BACKEND=disabled
